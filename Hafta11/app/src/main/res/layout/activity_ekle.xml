<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activites.EkleActivity">

    <EditText
        android:id="@+id/txt_ekle_adsoyad"
        android:layout_width="286dp"
        android:layout_height="60dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="89dp"
        android:layout_marginBottom="55dp"
        android:ems="10"
        android:hint="Müşteri Aıd Soyadı"
        android:inputType="text"
        app:layout_constraintBottom_toTopOf="@+id/txt_ekle_mail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/txt_ekle_mail"
        android:layout_width="286dp"
        android:layout_height="60dp"
        android:layout_marginBottom="45dp"
        android:ems="10"
        android:hint="Müşteri Maili"
        android:inputType="textEmailAddress"
        app:layout_constraintBottom_toTopOf="@+id/txt_ekle_telefon"
        app:layout_constraintStart_toStartOf="@+id/txt_ekle_adsoyad"
        app:layout_constraintTop_toBottomOf="@+id/txt_ekle_adsoyad" />

    <EditText
        android:id="@+id/txt_ekle_telefon"
        android:layout_width="286dp"
        android:layout_height="60dp"
        android:layout_marginBottom="49dp"
        android:ems="10"
        android:hint="Müşteri Telefonu"
        android:inputType="phone"
        app:layout_constraintBottom_toTopOf="@+id/btn_ekle"
        app:layout_constraintStart_toStartOf="@+id/txt_ekle_mail"
        app:layout_constraintTop_toBottomOf="@+id/txt_ekle_mail" />

    <Button
        android:id="@+id/btn_ekle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="265dp"
        android:text="Ekle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_ekle_telefon" />
</androidx.constraintlayout.widget.ConstraintLayout>